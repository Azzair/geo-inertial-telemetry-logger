{
  "name": "geo-inertial-telemetry-root",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "v1",
    "v2"
  ],
  "scripts": {
    "install-all": "npm install",
    "build:v1": "npm run build -w v1 -- --outDir ../dist/v1 --emptyOutDir",
    "build:v2": "npm run build -w v2 -- --outDir ../dist/v2 --emptyOutDir",
    "build": "npm run build:v1 && npm run build:v2 && cp index.html dist/index.html",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
